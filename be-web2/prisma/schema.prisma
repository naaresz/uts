generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Event {
  id          Int           @id @default(autoincrement())
  nama        String
  location    String
  dateEvent   DateTime      @map("date_event")
  description String        @db.Text
  categoryId  Int
  speakerId   Int
  createdAt   DateTime      @default(now()) @map("created_at")
  category    CategoryEvent @relation(fields: [categoryId], references: [id])
  speaker     Speaker       @relation(fields: [speakerId], references: [id])

  @@index([categoryId], map: "events_categoryId_fkey")
  @@index([speakerId], map: "events_speakerId_fkey")
  @@map("events")
}

model CategoryEvent {
  id          Int     @id @default(autoincrement())
  nama        String
  description String  @db.Text
  events      Event[]

  @@map("category_event")
}

model Speaker {
  id      Int     @id @default(autoincrement())
  nama    String
  materi  String? @db.Text
  jabatan String
  foto    String
  events  Event[]

  @@map("speakers")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  foto      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}
